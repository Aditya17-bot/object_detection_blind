# environment
venv/
# CUDA env (torch 2.6.0+cu124, the cp39 ceiling). Kept SEPARATE from venv/ on
# purpose: venv/ stays a known-good fallback. See CLAUDE.md "GPU enablement".
venv-gpu/
__pycache__/
*.pyc
.claude/

# git bundles used to move branches between machines when a session can't push
*.bundle

# auto-downloaded weights (ultralytics fetches these on first run;
# door_dustbin_stairs.pt is OUR trained model and IS committed)
yolov8n.pt
yolov8s.pt
yolo11n.pt

# offline speech model — grab it once from
# https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
# and unzip next to voice.py
vosk-model-small-en-us-0.15/

# local test footage (personal room videos) + generated frames/logs
test_output/
sync_log.txt

# TFLite export-pipeline artifacts — regenerate from the .pt via the wsl_export
# scripts; too large / derived to track
*.onnx
*_saved_model/
calibration_*.npy

# Flutter app bundled model assets (derived from the .pt export + the Vosk
# download); large binaries, regenerate before building the app
blindassist_app/assets/models/*.tflite
blindassist_app/assets/models/*.zip
dart_port/

# generated Gradle build output
blindassist_app/android/build/
blindassist_app/build/
blindassist_app/android/.kotlin/
